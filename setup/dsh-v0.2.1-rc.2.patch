diff --git a/packages/subprocess/subprocess/src/recovery.ts b/packages/subprocess/subprocess/src/recovery.ts
new file mode 100644
index 0000000..7a6d83d
--- /dev/null
+++ b/packages/subprocess/subprocess/src/recovery.ts
@@ -0,0 +1,37 @@
+/** Durable identities for provider-owned native process ranges. */
+
+import type { Branded } from '@deepseek-ai/dsh-brand'
+
+/** Unpredictable Windows Job Object name issued by a subprocess provider. */
+export type SubprocessRecoveryJobName = Branded<'SubprocessRecoveryJobName'>
+
+/** Native range identity safe to retain after the creating supervisor exits. */
+export interface SubprocessRangeReceipt {
+  kind: 'windows-job'
+  jobName: SubprocessRecoveryJobName
+}
+
+/**
+ * Decode a receipt read from durable storage or another process.
+ * @param value - untrusted receipt JSON.
+ * @returns the validated native range identity.
+ */
+export function parseSubprocessRangeReceipt(value: unknown): SubprocessRangeReceipt {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)
+    || !Object.hasOwn(value, 'kind') || !Object.hasOwn(value, 'jobName')
+    || !('kind' in value) || value.kind !== 'windows-job'
+    || !('jobName' in value) || typeof value.jobName !== 'string'
+    || !/^Global\\dsh-subprocess-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/u.test(value.jobName)
+    || Object.keys(value).length !== 2) {
+    throw new Error('Invalid subprocess recovery receipt')
+  }
+  return { kind: 'windows-job', jobName: value.jobName as SubprocessRecoveryJobName }
+}
+
+/** The selected provider cannot create or recover a durable native process range. */
+export class SubprocessRecoveryUnsupportedError extends Error {
+  constructor() {
+    super('This subprocess provider does not support durable native range recovery')
+    this.name = 'SubprocessRecoveryUnsupportedError'
+  }
+}
