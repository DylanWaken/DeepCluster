+/**
+ * Place the calling process in a fresh named kill-on-close Job before it creates children.
+ * The caller retains this handle until process exit; closing it terminates the caller too.
+ * @param api - loaded Win32 bindings.
+ * @param name - unpredictable globally unique Job name.
+ * @returns the owned Job handle, with the calling process already assigned.
+ */
+export function createRecoveryJobForCurrentProcess(api: Win32ProcessBindings, name: string): NativePtr {
+  const job = createKillOnCloseJob(api, name)
+  if (api.assignProcessToJobObject(job, api.getCurrentProcess()) === 0) {
+    const code = api.getLastError()
+    api.closeHandle(job)
+    throwWin32(api, 'AssignProcessToJobObject', code)
+  }
+  return job
+}
+
+/**
