+++ b/packages/subprocess/subprocess-local/src/recovery.ts
@@ -0,0 +1,50 @@
+/** Reopen and settle a durable native Windows subprocess range. */
+
+import { setTimeout } from 'node:timers/promises'
+import type { SubprocessRangeReceipt } from '@deepseek-ai/dsh-subprocess'
+import {
+  closeHandleChecked,
+  isJobEmpty,
+  loadWin32ProcessBindings,
+  openRecoveryJob,
+  terminateJob,
+} from '@deepseek-ai/dsh-win32-process'
+
+/** Native operations injected by recovery tests. */
+export interface WindowsRangeRecoveryInternals {
+  loadWin32ProcessBindings: typeof loadWin32ProcessBindings
+  openRecoveryJob: typeof openRecoveryJob
+  isJobEmpty: typeof isJobEmpty
+  terminateJob: typeof terminateJob
+  closeHandleChecked: typeof closeHandleChecked
+}
+
+const native: WindowsRangeRecoveryInternals = {
+  loadWin32ProcessBindings, openRecoveryJob, isJobEmpty, terminateJob, closeHandleChecked,
+}
+
+/**
+ * Terminate the exact named Job, including its runner and every nested child Job.
+ * @param receipt - provider-issued identity decoded by the durable-storage consumer.
+ * @param signal - cancels waiting without reporting successful recovery.
+ * @param internals - native operations used by deterministic tests.
+ * @returns after the Job is absent or its active-process count reaches zero.
+ */
+export async function recoverWindowsRange(
+  receipt: SubprocessRangeReceipt,
+  signal?: AbortSignal,
+  internals: WindowsRangeRecoveryInternals = native,
+): Promise<void> {
+  signal?.throwIfAborted()
+  const api = internals.loadWin32ProcessBindings()
+  const job = internals.openRecoveryJob(api, receipt.jobName)
+  if (job === null) return
+  try {
+    internals.terminateJob(api, job, 1)
+    while (!internals.isJobEmpty(api, job)) {
+      await setTimeout(10, undefined, { signal })
+    }
+  } finally {
+    internals.closeHandleChecked(api, job, 'recovered process Job')
+  }
+}
