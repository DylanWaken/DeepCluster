+export function openRecoveryJob(api: Win32ProcessBindings, name: string): NativePtr | null {
+  const job = api.openJobObjectW(abi.JOB_OBJECT_QUERY | abi.JOB_OBJECT_TERMINATE, 0, name)
+  if (!isNullPtr(job)) return job
+  const code = api.getLastError()
+  if (code === abi.ERROR_FILE_NOT_FOUND) return null
