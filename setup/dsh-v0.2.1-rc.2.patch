index 0000000000..03c9522406
--- /dev/null
+++ b/packages/subprocess/subprocess-local/tests/recovery.spec.ts
@@ -0,0 +1,65 @@
+import { describe, expect, it, vi } from 'vitest'
+import { parseSubprocessRangeReceipt } from '@deepseek-ai/dsh-subprocess'
+import type { CurrentTokenProcessBindings, NativePtr } from '@deepseek-ai/dsh-win32-process'
+import { recoverWindowsRange } from '../src/recovery.ts'
+import type { WindowsRangeRecoveryInternals } from '../src/recovery.ts'
+
+const receipt = parseSubprocessRangeReceipt({ kind: 'windows-job', jobName: 'Global\\dsh-subprocess-12345678-1234-4234-8234-123456789abc' })
+const job = 23n as NativePtr
+
+function native(overrides: Partial<WindowsRangeRecoveryInternals> = {}): WindowsRangeRecoveryInternals {
+  return {
+    loadWin32ProcessBindings: vi.fn(() => ({} as CurrentTokenProcessBindings)),
+    openRecoveryJob: vi.fn(() => job),
+    isJobEmpty: vi.fn(() => true),
+    terminateJob: vi.fn(),
+    closeHandleChecked: vi.fn(),
+    ...overrides,
+  }
+}
+
+describe('Windows durable range recovery', () => {
+  it('decodes only exact provider receipts before native recovery', () => {
+    expect(parseSubprocessRangeReceipt(JSON.parse(JSON.stringify(receipt)))).toEqual(receipt)
+    for (const value of [null, [], {}, { ...receipt, pid: 123 }, { ...receipt, kind: 'pid' },
+      { ...receipt, jobName: 'Global\\other-job' }, { ...receipt, jobName: receipt.jobName + '\\child' },
+      { ...receipt, jobName: receipt.jobName.replace('-4234-', '-1234-') }]) {
+      expect(() => parseSubprocessRangeReceipt(value)).toThrow('Invalid subprocess recovery receipt')
+    }
+  })
+
+  it('returns for a missing Job without creating or terminating any process', async () => {
+    const api = native({ openRecoveryJob: vi.fn(() => null) })
+    await recoverWindowsRange(receipt, undefined, api)
+    expect(api.openRecoveryJob).toHaveBeenCalledWith({}, receipt.jobName)
+    expect(api.terminateJob).not.toHaveBeenCalled()
+    expect(api.closeHandleChecked).not.toHaveBeenCalled()
+  })
+
+  it('awaits empty Job accounting after accepted termination', async () => {
+    const api = native({ isJobEmpty: vi.fn().mockReturnValueOnce(false).mockReturnValueOnce(false).mockReturnValue(true) })
+    await recoverWindowsRange(receipt, undefined, api)
+    expect(api.terminateJob).toHaveBeenCalledExactlyOnceWith({}, job, 1)
+    expect(api.isJobEmpty).toHaveBeenCalledTimes(3)
+    expect(api.closeHandleChecked).toHaveBeenCalledExactlyOnceWith({}, job, 'recovered process Job')
+  })
+
+  it('retains failure when opening, terminating, querying, or closing the Job fails', async () => {
+    for (const operation of ['openRecoveryJob', 'terminateJob', 'isJobEmpty', 'closeHandleChecked'] as const) {
+      const error = new Error(operation)
+      const api = native({ [operation]: vi.fn(() => { throw error }) })
+      await expect(recoverWindowsRange(receipt, undefined, api)).rejects.toBe(error)
+      if (operation !== 'openRecoveryJob') expect(api.closeHandleChecked).toHaveBeenCalledOnce()
+    }
+  })
+
+  it('aborts an unsettled observation and closes only its opened native handle', async () => {
+    const controller = new AbortController()
+    const api = native({ isJobEmpty: vi.fn(() => { controller.abort(new Error('deadline')); return false }) })
+    await expect(recoverWindowsRange(receipt, controller.signal, api)).rejects.toThrow()
+    expect(api.closeHandleChecked).toHaveBeenCalledOnce()
+    const untouched = native()
+    await expect(recoverWindowsRange(receipt, controller.signal, untouched)).rejects.toThrow('deadline')
+    expect(untouched.loadWin32ProcessBindings).not.toHaveBeenCalled()
+  })
+})
diff --git a/packages/subprocess/win32-process/tests/recovery.spec.ts b/packages/subprocess/win32-process/tests/recovery.spec.ts
new file mode 100644
index 0000000000..25ab08587f
--- /dev/null
+++ b/packages/subprocess/win32-process/tests/recovery.spec.ts
@@ -0,0 +1,50 @@
+import { describe, expect, it, vi } from 'vitest'
+import { createRecoveryJobForCurrentProcess, openRecoveryJob } from '../src/process.ts'
+import type { NativePtr, Win32ProcessBindings } from '../src/ffi.ts'
+
+function native(overrides: Partial<Win32ProcessBindings> = {}) {
+  const methods = {
+    createJobObjectW: vi.fn(() => 3n as NativePtr),
+    openJobObjectW: vi.fn(() => 3n as NativePtr),
+    getCurrentProcess: vi.fn(() => 4n as NativePtr),
+    setInformationJobObject: vi.fn(() => 1),
+    assignProcessToJobObject: vi.fn(() => 1),
+    closeHandle: vi.fn(() => 1),
+    getLastError: vi.fn(() => 0),
+    formatMessageW: vi.fn(() => 0),
+  }
+  return { api: { ...methods, ...overrides } as Win32ProcessBindings, methods }
+}
+
+describe('named native recovery Job', () => {
+  it('assigns the current runner before returning its named kill-on-close handle', () => {
+    const { api, methods } = native()
+    expect(createRecoveryJobForCurrentProcess(api, 'Global\\unique')).toBe(3n)
+    expect(methods.createJobObjectW).toHaveBeenCalledWith(null, 'Global\\unique')
+    expect(methods.setInformationJobObject).toHaveBeenCalledOnce()
+    expect(methods.assignProcessToJobObject).toHaveBeenCalledWith(3n, 4n)
+    expect(methods.closeHandle).not.toHaveBeenCalled()
+  })
+
+  it('rejects a name collision without changing or terminating the existing Job', () => {
+    const { api, methods } = native({ getLastError: () => 183 })
+    expect(() => createRecoveryJobForCurrentProcess(api, 'Global\\collision')).toThrow('183')
+    expect(methods.closeHandle).toHaveBeenCalledWith(3n)
+    expect(methods.setInformationJobObject).not.toHaveBeenCalled()
+    expect(methods.assignProcessToJobObject).not.toHaveBeenCalled()
+  })
+
+  it('closes a newly created Job on assignment failure', () => {
+    const { api, methods } = native({ assignProcessToJobObject: () => 0, getLastError: () => 5 })
+    expect(() => createRecoveryJobForCurrentProcess(api, 'Global\\unique')).toThrow('AssignProcessToJobObject')
+    expect(methods.closeHandle).toHaveBeenCalledWith(3n)
+  })
+
+  it('opens only query and terminate access and distinguishes absence from denied access', () => {
+    const { api, methods } = native()
+    expect(openRecoveryJob(api, 'Global\\unique')).toBe(3n)
+    expect(methods.openJobObjectW).toHaveBeenCalledWith(12, 0, 'Global\\unique')
+    expect(openRecoveryJob(native({ openJobObjectW: () => 0n as NativePtr, getLastError: () => 2 }).api, 'missing')).toBeNull()
+    expect(() => openRecoveryJob(native({ openJobObjectW: () => 0n as NativePtr, getLastError: () => 5 }).api, 'denied')).toThrow('OpenJobObjectW')
+  })
+})
diff --git a/packages/subprocess/win32-process/tests/recovery-native.spec.ts b/packages/subprocess/win32-process/tests/recovery-native.spec.ts
new file mode 100644
index 0000000000..6796a67d39
--- /dev/null
+++ b/packages/subprocess/win32-process/tests/recovery-native.spec.ts
@@ -0,0 +1,52 @@
+import { spawn } from 'node:child_process'
+import { randomUUID } from 'node:crypto'
+import { fileURLToPath } from 'node:url'
+import { setTimeout } from 'node:timers/promises'
+import { describe, expect, it } from 'vitest'
+import { closeHandleChecked, isJobEmpty, loadWin32ProcessBindings, openRecoveryJob, terminateJob } from '../src/index.ts'
+
+describe.skipIf(process.platform !== 'win32')('Windows native durable Job recovery', () => {
+  it('reopens the owner Job and joins its runner, child and grandchild', async () => {
+    const name = `Global\\dsh-subprocess-${randomUUID()}`
+    const fixture = fileURLToPath(new URL('./fixtures/recovery-owner.ts', import.meta.url))
+    const child = spawn(process.execPath, ['--import', 'tsx/esm', fixture, name], {
+      stdio: ['ignore', 'ignore', 'pipe', 'ipc'], windowsHide: true,
+    })
+    let stderr = ''
+    child.stderr?.on('data', (data: Buffer) => { stderr += data.toString() })
+    const exited = new Promise<void>((resolve, reject) => {
+      child.once('exit', () => { resolve() })
+      child.once('error', reject)
+    })
+    const api = loadWin32ProcessBindings()
+    const signal = AbortSignal.timeout(15_000)
+    try {
+      await new Promise<void>((resolve, reject) => {
+        const onAbort = (): void => { reject(new Error('native owner readiness timed out', { cause: signal.reason })) }
+        signal.addEventListener('abort', onAbort, { once: true })
+        child.once('message', () => { signal.removeEventListener('abort', onAbort); resolve() })
+        child.once('exit', () => { signal.removeEventListener('abort', onAbort); reject(new Error(`owner exited before readiness: ${stderr}`)) })
+        child.once('error', reject)
+      })
+      const job = openRecoveryJob(api, name)
+      expect(job).not.toBeNull()
+      if (job === null) throw new Error('ready owner has no named Job')
+      try {
+        expect(isJobEmpty(api, job)).toBe(false)
+        terminateJob(api, job, 1)
+        while (!isJobEmpty(api, job)) await setTimeout(10, undefined, { signal })
+      } finally {
+        closeHandleChecked(api, job, 'test recovery Job')
+      }
+      await exited
+      expect(openRecoveryJob(api, name)).toBeNull()
+    } finally {
+      const remaining = openRecoveryJob(api, name)
+      if (remaining !== null) {
+        try { terminateJob(api, remaining, 1) } finally { closeHandleChecked(api, remaining, 'test failure cleanup') }
+      }
+      child.kill()
+      await exited
+    }
+  }, 20_000)
+})
