@@ -0,0 +1,17 @@
+/** Disposable native owner used by the Windows recovery integration test. */
+
+import { spawn } from 'node:child_process'
+import { createRecoveryJobForCurrentProcess, loadWin32ProcessBindings } from '../../src/index.ts'
+
+const name = process.argv[2]
+if (name === undefined) throw new Error('missing recovery Job name')
+createRecoveryJobForCurrentProcess(loadWin32ProcessBindings(), name)
+const target = spawn(process.execPath, ['-e', `
+  const { spawn } = require('node:child_process')
+  const child = spawn(process.execPath, ['-e', 'setInterval(() => {}, 1000)'], { stdio: 'ignore', windowsHide: true })
+  child.once('spawn', () => { process.stdout.write('descendant-ready\\n') })
+  setInterval(() => {}, 1000)
+`], { stdio: ['ignore', 'pipe', 'inherit'], windowsHide: true })
+target.stdout.once('data', () => { process.send?.({ ready: true }) })
+target.on('error', (error) => { throw error })
+setInterval(() => {}, 1000)
